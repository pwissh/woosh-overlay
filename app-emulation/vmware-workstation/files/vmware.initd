#!/sbin/openrc-run
# Copyright 2026 Gentoo Authors
# Distributed under the terms of the GNU General Public License v2

description="VMware Workstation services (networking, USB arbitration)"

depend() {
	need net
	after udev
}

start() {
	ebegin "Loading VMware kernel modules"
	modprobe vmw_vmci 2>/dev/null || true
	modprobe vmmon && modprobe vmnet
	eend $? "Failed to load vmmon/vmnet — try: emerge @module-rebuild" || return 1

	ebegin "Configuring VMware networks"
	if /usr/bin/vmware-networks --start; then
		eend 0
	else
		eend 1
		ewarn "VMware network configuration failed — no virtual network interfaces created."
		ewarn "This is usually caused by no network connection being available."
		ewarn "Once network is up, run: rc-service vmware restart"
		ewarn "VMs can still be started but will have no network access."
	fi

	if yesno "${VMWARE_USB:-yes}"; then
		ebegin "Starting VMware USB arbitrator"
		start-stop-daemon --start --background \
			--exec /usr/bin/vmware-usbarbitrator -- -f
		eend $?
	fi
}

stop() {
	if yesno "${VMWARE_USB:-yes}"; then
		ebegin "Stopping VMware USB arbitrator"
		/usr/bin/vmware-usbarbitrator -k
		eend $?
	fi

	ebegin "Stopping VMware networks"
	/usr/bin/vmware-networks --stop
	eend $?

	ebegin "Unloading VMware kernel modules"
	rmmod vmw_vmci vmnet vmmon 2>/dev/null
	# Non-fatal — modules may still be in use if a VM is running
	eend 0
}
